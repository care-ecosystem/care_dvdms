// DVDMS Integration Data Models - CARE DVDMS Plugin
// Foreign keys use integer id; external_id UUID for API exposure

// ============================================================================
// INSTITUTE MAPPING - Facility to DVDMS Institute (1:1 relationship)
// ============================================================================
Table dvdms_institute {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null, note: 'Exposed via API as id']
  facility_id INTEGER [not null, unique, note: 'FK to care_facility.id - one per facility']

  eaushadhi_institute_id VARCHAR(50) [not null, unique, note: 'DVDMS institute identifier']
  eaushadhi_institute_name VARCHAR(255) [not null, note: 'Human-readable institute name']
  eaushadhi_user_ref_id VARCHAR(50) [not null, note: 'DVDMS user seat ID for API auth']
  schema_version VARCHAR(10) [not null, default: '1.0', note: 'API schema version']

  created_date TIMESTAMP [not null, note: "indexed"]
  modified_date TIMESTAMP [not null, note: "indexed"]
  deleted BOOLEAN [default: false, note: "indexed"]

  created_by_id INTEGER [null, note: 'FK to care_user.id - who created']
  updated_by_id INTEGER [null, note: 'FK to care_user.id - who last updated']

  history JSON [default: '{}', note: 'Change tracking history']
  meta JSON [default: 'null', null, note: 'Arbitrary metadata']

  indexes {
    facility_id
    deleted
  }
}

Ref institute_facility: dvdms_institute.facility_id ?> care_facility.id
Ref institute_created_by: dvdms_institute.created_by_id ?> care_user.id
Ref institute_updated_by: dvdms_institute.updated_by_id ?> care_user.id

// ============================================================================
// SUPPLIER MAPPING - CARE Supplier to DVDMS Warehouse (N:1 relationship)
// ============================================================================
Table dvdms_supplier {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null, note: 'Exposed via API as id']
  institute_id INTEGER [not null, note: 'FK to dvdms_institute.id']
  supplier_id INTEGER [not null, note: 'FK to care_organization.id - type=product_supplier']

  eaushadhi_warehouse_id VARCHAR(50) [not null, note: 'DVDMS warehouse from_store ID']
  eaushadhi_warehouse_name VARCHAR(255) [not null, note: 'DVDMS warehouse name']

  is_default BOOLEAN [default: false, note: 'Default supplier for unmapped warehouses (unique per institute)']

  created_date TIMESTAMP [not null, note: "indexed"]
  modified_date TIMESTAMP [not null, note: "indexed"]
  deleted BOOLEAN [default: false, note: "indexed"]

  created_by_id INTEGER [null]
  updated_by_id INTEGER [null]

  history JSON [default: '{}']
  meta JSON [default: 'null', null]

  indexes {
    institute_id
    supplier_id
    eaushadhi_warehouse_id
    deleted
    (institute_id, supplier_id) [unique, note: 'each supplier mapped once per institute']
    (institute_id, is_default) [note:'IMPLEMENTATION: PostgreSQL partial unique index WHERE is_default=true AND deleted=false. DBML cannot express conditional constraints; this diagram placeholder must not be treated as an unconditional unique constraint.']
  }
}

Ref supplier_institute: dvdms_supplier.institute_id ?> dvdms_institute.id
Ref supplier_org: dvdms_supplier.supplier_id ?> care_organization.id
Ref supplier_created_by: dvdms_supplier.created_by_id ?> care_user.id
Ref supplier_updated_by: dvdms_supplier.updated_by_id ?> care_user.id

// ============================================================================
// STORE MAPPING - CARE Store to DVDMS Store (N:1 relationship)
// ============================================================================
Table dvdms_store {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null, note: 'Exposed via API as id']
  institute_id INTEGER [not null, note: 'FK to dvdms_institute.id']
  location_id INTEGER [not null, note: 'FK to care_location.id - CARE facility location (counter/pharmacy)']

  eaushadhi_store_id VARCHAR(50) [not null, note: 'DVDMS store to_store ID']
  eaushadhi_store_name VARCHAR(255) [not null, note: 'DVDMS store name']

  is_default BOOLEAN [default: false, note: 'Default store for indent/issue operations (unique per institute)']

  created_date TIMESTAMP [not null, note: "indexed"]
  modified_date TIMESTAMP [not null, note: "indexed"]
  deleted BOOLEAN [default: false, note: "indexed"]

  created_by_id INTEGER [null]
  updated_by_id INTEGER [null]

  history JSON [default: '{}']
  meta JSON [default: 'null', null]

  indexes {
    institute_id
    location_id
    eaushadhi_store_id
    deleted
    (institute_id, location_id) [unique, note: 'each location mapped once per institute']
    (institute_id, is_default) [note: 'IMPLEMENTATION: PostgreSQL partial unique index WHERE is_default=true AND deleted=false. DBML cannot express conditional constraints; this diagram placeholder must not be treated as an unconditional unique constraint.']
  }
}

Ref store_institute: dvdms_store.institute_id ?> dvdms_institute.id
Ref store_location: dvdms_store.location_id ?> care_location.id
Ref store_created_by: dvdms_store.created_by_id ?> care_user.id
Ref store_updated_by: dvdms_store.updated_by_id ?> care_user.id

// ============================================================================
// RECORD ORDER - DVDMS Indent/Requisition Order (N:1 relationship)
// Maps a CARE request order to DVDMS store/supplier mappings for sync
// ============================================================================
Table dvdms_record_order {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null, note: 'Exposed via API as id']

  institute_id INTEGER [not null, note: 'FK to dvdms_institute.id']
  order_id INTEGER [not null, unique, note: 'FK to care_request_order.id - the CARE order being synced (1:1). ON DELETE PROTECT']
  institute_store_id INTEGER [not null, note: 'FK to dvdms_store.id - destination store. ON DELETE PROTECT']
  institute_supplier_id INTEGER [not null, note: 'FK to dvdms_supplier.id - source warehouse. ON DELETE PROTECT']

  name VARCHAR(255) [not null, note: 'Order name (e.g., "eaushadhi")']

  status VARCHAR(20) [not null, default: 'draft',
    note: 'Order status: draft, pending, approved, rejected, completed, failed, cancelled']

  created_date TIMESTAMP [not null, note: "indexed"]
  modified_date TIMESTAMP [not null, note: "indexed"]
  deleted BOOLEAN [default: false, note: "indexed"]

  created_by_id INTEGER [null]
  updated_by_id INTEGER [null]

  history JSON [default: '{}']
  meta JSON [default: 'null', null]

  indexes {
    institute_id
    order_id
    institute_store_id
    institute_supplier_id
    status
    deleted
  }
}

Ref record_order_institute: dvdms_record_order.institute_id ?> dvdms_institute.id
Ref record_order_care_order: dvdms_record_order.order_id - care_request_order.id
Ref record_order_store: dvdms_record_order.institute_store_id ?> dvdms_store.id
Ref record_order_supplier: dvdms_record_order.institute_supplier_id ?> dvdms_supplier.id
Ref record_order_created_by: dvdms_record_order.created_by_id ?> care_user.id
Ref record_order_updated_by: dvdms_record_order.updated_by_id ?> care_user.id

// ============================================================================
// DVDMS DRUG - Snapshot of a DVDMS drug/item (1:1 owned by a record item order)
// ============================================================================
Table dvdms_drug {
  id INTEGER [pk, increment]

  drug_id VARCHAR(50) [not null, note: 'DVDMS item ID']
  name VARCHAR(255) [not null, note: 'Drug name']
  brand_id VARCHAR(50) [default: '', note: 'DVDMS brand ID']
  group_id VARCHAR(50) [default: '', note: 'DVDMS group ID']
  sub_group_id VARCHAR(50) [default: '', note: 'DVDMS subgroup ID']
  unit_id VARCHAR(50) [default: '', note: 'DVDMS unit ID']
  drug_category VARCHAR(50) [default: '', note: 'Drug category']
}

// ============================================================================
// RECORD ITEM ORDER - Line Items in DVDMS Orders (N:1 relationship)
// Maps a CARE supply request to a DVDMS drug snapshot within a record order
// ============================================================================
Table dvdms_record_item_order {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null, note: 'Exposed via API as id']

  institute_id INTEGER [not null, note: 'FK to dvdms_institute.id - denormalized for fast lookup']
  record_order_id INTEGER [not null, note: 'FK to dvdms_record_order.id - parent order']
  supply_request_id INTEGER [not null, unique, note: 'FK to care_supply_request.id - CARE supply request (1:1). ON DELETE PROTECT']
  drug_id INTEGER [not null, unique, note: 'FK to dvdms_drug.id - 1:1 drug snapshot owned by this item order']

  created_date TIMESTAMP [not null, note: "indexed"]
  modified_date TIMESTAMP [not null, note: "indexed"]
  deleted BOOLEAN [default: false, note: "indexed"]

  created_by_id INTEGER [null]
  updated_by_id INTEGER [null]

  history JSON [default: '{}']
  meta JSON [default: 'null', null]

  indexes {
    institute_id
    record_order_id
    supply_request_id
    deleted
  }
}

Ref item_order_institute: dvdms_record_item_order.institute_id ?> dvdms_institute.id
Ref item_order_record_order: dvdms_record_item_order.record_order_id ?> dvdms_record_order.id
Ref item_order_supply_request: dvdms_record_item_order.supply_request_id - care_supply_request.id
Ref item_order_drug: dvdms_record_item_order.drug_id - dvdms_drug.id
Ref item_order_created_by: dvdms_record_item_order.created_by_id ?> care_user.id
Ref item_order_updated_by: dvdms_record_item_order.updated_by_id ?> care_user.id

// ============================================================================
// SYNC LOG - Audit trail for DVDMS fetch/sync API calls (N:1 relationship)
// ============================================================================
Table dvdms_sync_log {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null, note: 'Exposed via API as id']

  institute_id INTEGER [not null, note: 'FK to dvdms_institute.id']

  triggered_by VARCHAR(20) [not null, default: 'user', note: 'user, cron, retry']
  sync_type VARCHAR(20) [not null, note: 'save_indent, track_indent, acknowledge']
  request_status VARCHAR(20) [not null, default: 'pending', note: 'pending, success, failure']

  http_status_code SMALLINT [null, note: 'HTTP status code received from the DVDMS API']
  request_payload JSON [null, note: 'Request payload sent to the DVDMS API']
  response_payload JSON [null, note: 'Response payload received from the DVDMS API']
  error_detail TEXT [null, note: 'Details of the error if the request fails']
  api_response_time_ms INTEGER [null, note: 'API response time in milliseconds']
  retry_count INTEGER [not null, default: 0, note: 'Number of retry attempts for the fetch']

  created_date TIMESTAMP [not null, note: "indexed"]
  modified_date TIMESTAMP [not null, note: "indexed"]
  deleted BOOLEAN [default: false, note: "indexed"]

  created_by_id INTEGER [null]
  updated_by_id INTEGER [null]

  history JSON [default: '{}']
  meta JSON [default: 'null', null]

  indexes {
    institute_id
    request_status
    deleted
  }
}

Ref sync_log_institute: dvdms_sync_log.institute_id ?> dvdms_institute.id
Ref sync_log_created_by: dvdms_sync_log.created_by_id ?> care_user.id
Ref sync_log_updated_by: dvdms_sync_log.updated_by_id ?> care_user.id

// ============================================================================
// OUTWARD RECORD ORDER - e-Aushadhi Indent tracking (1:1 owned by a record order)
// ============================================================================
Table dvdms_outward_record_order {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null, note: 'Exposed via API as id']

  record_order_id INTEGER [not null, unique, note: 'FK to dvdms_record_order.id (1:1)']
  status VARCHAR(20) [not null, default: 'created', note: 'Outwards record status: created, submitted, cancelled, failed']
  eaushadhi_indent_no VARCHAR(255) [null, note: 'e-Aushadhi indent number']
  eaushadhi_indent_status VARCHAR(255) [null, note: 'Current status of the e-Aushadhi indent']
  sync_log_id INTEGER [null, note: 'FK to dvdms_sync_log.id. ON DELETE SET NULL']

  created_date TIMESTAMP [not null, note: "indexed"]
  modified_date TIMESTAMP [not null, note: "indexed"]
  deleted BOOLEAN [default: false, note: "indexed"]

  created_by_id INTEGER [null]
  updated_by_id INTEGER [null]

  history JSON [default: '{}']
  meta JSON [default: 'null', null]

  indexes {
    record_order_id
    sync_log_id
    deleted
  }
}

Ref outward_record_order_record_order: dvdms_outward_record_order.record_order_id - dvdms_record_order.id
Ref outward_record_order_sync_log: dvdms_outward_record_order.sync_log_id ?> dvdms_sync_log.id
Ref outward_record_order_created_by: dvdms_outward_record_order.created_by_id ?> care_user.id
Ref outward_record_order_updated_by: dvdms_outward_record_order.updated_by_id ?> care_user.id

// ============================================================================
// PRODUCT MAPPING - DVDMS drug snapshot to CARE ProductKnowledge (1:1 drug side)
// ============================================================================
Table dvdms_product_mapping {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null, note: 'Exposed via API as id']

  institute_id INTEGER [not null, note: 'FK to dvdms_institute.id']
  drug_id INTEGER [not null, unique, note: 'FK to dvdms_drug.id (1:1) - the DVDMS drug snapshot being mapped. ON DELETE PROTECT']
  product_knowledge_id INTEGER [not null, note: 'FK to care_product_knowledge.id - many drugs can map to the same product. ON DELETE PROTECT']

  mapping_type VARCHAR(20) [not null, default: 'manual_mapping', note: 'default_mapping, manual_mapping']
  usage_count INTEGER [not null, default: 0]
  last_used_date TIMESTAMP [null]

  created_date TIMESTAMP [not null, note: "indexed"]
  modified_date TIMESTAMP [not null, note: "indexed"]
  deleted BOOLEAN [default: false, note: "indexed"]

  created_by_id INTEGER [null]
  updated_by_id INTEGER [null]

  history JSON [default: '{}']
  meta JSON [default: 'null', null]

  indexes {
    institute_id
    product_knowledge_id
    mapping_type
    deleted
  }
}

Ref product_mapping_institute: dvdms_product_mapping.institute_id ?> dvdms_institute.id
Ref product_mapping_drug: dvdms_product_mapping.drug_id - dvdms_drug.id
Ref product_mapping_product_knowledge: dvdms_product_mapping.product_knowledge_id ?> care_product_knowledge.id
Ref product_mapping_created_by: dvdms_product_mapping.created_by_id ?> care_user.id
Ref product_mapping_updated_by: dvdms_product_mapping.updated_by_id ?> care_user.id

// ============================================================================
// CARE MODELS - External References
// ============================================================================

Table care_user {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null]
}

Table care_facility {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null]
}

Table care_location {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null]
  facility_id INTEGER [not null, note: "FK to care_facility.id"]
  name VARCHAR(255) [not null]
  form VARCHAR(255) [not null, note: "e.g., ro, counter, pharmacy"]
}

Ref location_facility: care_location.facility_id ?> care_facility.id

Table care_organization {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null]
}

Table care_request_order {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null]

  destination_id INTEGER [not null, note: "FK to care_location"]
  origin_id INTEGER [null, note: "FK to care_location"]
  supplier_id INTEGER [null, note: "FK to care_organization"]
}

Ref order_destination: care_request_order.destination_id ?> care_location.id
Ref order_origin: care_request_order.origin_id ?> care_location.id
Ref order_supplier: care_request_order.supplier_id ?> care_organization.id

Table care_product_knowledge {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null]
}

Table care_supply_request {
  id INTEGER [pk, increment]
  external_id UUID [unique, not null]

  order_id INTEGER [not null, note: "FK to care_request_order"]
  item_id INTEGER [not null, note: "FK to care_product_knowledge"]
}

Ref supply_request_order: care_supply_request.order_id ?> care_request_order.id
Ref supply_request_item: care_supply_request.item_id ?> care_product_knowledge.id
